{
  "name": "fossil-voxel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ボクセル風 発掘＆オートバトル アドベンチャー",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "artifact": "npm run build && node tools/make-artifact.mjs",
    "run": "esbuild tools/run.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/run.mjs --log-level=error && node node_modules/.cache/run.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
